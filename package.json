{
  "name": "ntuadf-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "hugo --minify",
    "test:unit": "python3 -m unittest discover -s tests -v",
    "test:site": "python3 scripts/check_site.py public",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "bootstrap": "5.3.9"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@playwright/test": "1.65.1"
  }
}
